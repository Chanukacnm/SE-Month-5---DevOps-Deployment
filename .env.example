# Copy to .env and fill in. .env is git-ignored: never commit real secrets.

# Required
POSTGRES_PASSWORD=change-me
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional
POSTGRES_USER=adminflow
POSTGRES_DB=adminflow
HTTP_PORT=8080
API_PORT=3000
LOG_LEVEL=info
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Run the images CI pushed instead of building locally:
#   REGISTRY_PREFIX=ghcr.io/<github-user>/<repo>  IMAGE_TAG=sha-<commit>
#   docker compose pull && docker compose up -d --no-build
REGISTRY_PREFIX=adminflow
IMAGE_TAG=local
