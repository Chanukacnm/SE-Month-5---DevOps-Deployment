    {
      "id": 12,
      "type": "timeseries",
      "title": "Database connections",
      "description": "Node pg pool by state, plus server-side backends from postgres-exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
