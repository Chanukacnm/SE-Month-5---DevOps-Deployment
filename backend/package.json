{
  "name": "adminflow-api",
  "version": "1.0.0",
  "private": true,
  "description": "AdminFlow REST API: Express + PostgreSQL",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "express": "5.3.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "winston": "3.19.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "supertest": "7.3.1"
  }
}
