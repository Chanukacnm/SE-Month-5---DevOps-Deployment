        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 15,
      "type": "logs",
      "title": "API logs (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{project=\"adminflow\", service=\"backend\"} | json | line_format `{{ if .method }}{{ .method }} {{ .path }} -> {{ .status }} ({{ .durationMs }} ms){{ else }}{{ .message }}{{ if .error }}: {{ .error }}{{ end }}{{ end }}`",
          "legendFormat": "",
